# The Kiota-generated client is regenerated on different platforms — Windows for
# local dev, Linux for the CI drift gate (#129). Pin its output to LF so git
# compares byte-identical content regardless of the generator's platform newline;
# otherwise the drift gate could fail on a pure line-ending difference. The files
# are already stored as LF, so this introduces no renormalization.
src/Clients/Filer.ApiClient/Generated/** text eol=lf

# Shell scripts run on Linux (the deployment node, and the backlog generators via
# `bash`). A CRLF checkout makes the shebang `#!/usr/bin/env bash\r`, which fails
# with a bare "not found" that points nowhere near the real cause. Pin LF so a
# contributor's core.autocrlf setting cannot produce that.
*.sh text eol=lf

# systemd units and the .env template are copied verbatim onto the Linux node.
# A CRLF checkout would smuggle `\r` into unit values and sourced variables —
# `ExecStart=/usr/local/bin/backup-filer\r` or a password ending in `\r` — both
# failing far from the real cause. Pin LF like the shell scripts above.
deploy/*.service text eol=lf
deploy/*.timer text eol=lf
deploy/.env.example text eol=lf
