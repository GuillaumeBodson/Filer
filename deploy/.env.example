# Modèle de configuration pour docker-compose.prod.yml.
# À copier en /srv/filer/.env — jamais commité (cf. 11-git-workflow.md).
#
#   cp .env.example /srv/filer/.env
#   chmod 600 /srv/filer/.env      # contient des secrets en clair
#
# Le fichier docker-compose.prod.yml refuse de démarrer si POSTGRES_*, ou
# JWT_SIGNING_KEY manquent (syntaxe ${VAR:?message}) — panne immédiate et
# explicite plutôt qu'un conteneur qui démarre avec les identifiants de dev.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=filer
POSTGRES_USER=filer
# Générer : openssl rand -base64 32
POSTGRES_PASSWORD=CHANGER_MOI

# --- JWT ---------------------------------------------------------------------
# ≥ 32 caractères, obligatoire. Générer : openssl rand -base64 48
JWT_SIGNING_KEY=CHANGER_MOI

# --- Image déployée (ADR-018) ------------------------------------------------
# Le serveur ne compile plus rien : il tire l'image publiée par la CI sur GHCR.
# Le dépôt Filer étant public, le paquet GHCR l'est aussi — aucun `docker login`
# n'est nécessaire sur le serveur. (Si le dépôt passait en privé, il faudrait un
# PAT `read:packages` ici — c'est la seule chose que ce changement casserait.)
FILER_IMAGE=ghcr.io/guillaumebodson/filer-api

# ⚠️ Toujours un tag FIGÉ — jamais `latest`. C'est la version déployée, et donc
# le point de retour arrière : pour annuler un déploiement, remettre le tag
# précédent ici puis `pull` + `up -d`. Le job CD réécrit cette ligne.
#   openssl rand ...          -> non, ici : `git tag` / la liste des packages GHCR
#   exemples : v0.3.1  ou  sha-a1b2c3d
FILER_IMAGE_TAG=CHANGER_MOI

# --- Ollama ------------------------------------------------------------------
# Doit correspondre à un modèle réellement tiré : `ollama pull <modèle>`.
#
# Décision 2026-08-09 : modèle de production = MoE en offload hybride GPU/CPU
# (cf. choix-runtime-llm.md). 8 Go de VRAM + 62 Go de RAM :
#   qwen3:30b-a3b   <- cible (30B total / ~3B actifs, ~18 Go, split GPU/CPU)
#   gpt-oss:20b     <- repli si le 30B est trop lent (~12-14 Go)
#   llama3.2:3b     <- dépannage dense 100% GPU, validé bout-en-bout à la mise
#                      en service du nœud
#
# ⚠️ Ne bascule OLLAMA_MODEL sur le MoE qu'APRÈS l'avoir tiré et calibré (num_gpu),
# sinon premier démarrage cassé. Le dense ci-dessous est un défaut sûr.
OLLAMA_MODEL=llama3.2:3b
