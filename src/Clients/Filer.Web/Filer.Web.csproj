<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Thin Blazor WebAssembly host (ADR-001/ADR-012). Carries only the WASM bootstrap
    and host wiring; all reusable UI lives in Filer.Ui. The WASM-specific packages
    stop here so the shared RCL and API client stay reusable by the MAUI shell (RM-02).
    TargetFramework / Nullable / analysis are inherited from Directory.Build.props.
  -->

  <PropertyGroup>
    <!-- No asset fingerprinting: the html-placeholder substitution that resolves
         fingerprinted names (#[.{fingerprint}], preload, importmap) runs only in
         this project's OWN publish — not when Filer.Api publishes it into the api
         image (ADR-019). Shipped that way, index.html keeps the raw placeholder
         and the WASM bootstrap 404s. Plain names make build and publish output
         identical; the cache-busting loss is acceptable at this scale. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filer.Ui\Filer.Ui.csproj" />
    <ProjectReference Include="..\Filer.ApiClient\Filer.ApiClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ITokenStore implementation stays internal; its tests live with the other
         client auth tests (12-testing-strategy.md, #170). -->
    <InternalsVisibleTo Include="Filer.Ui.Tests" />
  </ItemGroup>

</Project>
